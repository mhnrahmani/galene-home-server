# Copy to .env and adjust.

# Public host name clients use to reach the server (required).
GALENE_HOST=meet.example.com

# Port for the web UI / signalling (TCP).
GALENE_HTTP_PORT=8443

# Port for the built-in TURN server (TCP and UDP).
GALENE_TURN_PORT=1194

# Public address of the TURN server, if it differs from GALENE_HOST:port.
#GALENE_TURN=<IP>:1194

# Admin account.  The password is only needed on the first start; you can
# remove it from this file afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=
