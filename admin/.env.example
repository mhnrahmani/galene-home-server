# Copy to .env and adjust.

# Where the admin GUI listens on the host.
#   127.0.0.1  localhost only, no login; reach it through an SSH tunnel
#              (recommended).
#   0.0.0.0    reachable from the network; HTTPS with Galene's certificate
#              and login with the Galene admin account.
ADMIN_GUI_LISTEN=127.0.0.1

# Port of the admin GUI.  Open it in your firewall/router only if
# ADMIN_GUI_LISTEN is not 127.0.0.1.
ADMIN_GUI_PORT=8444

# Name of the Galene container (container_name in ../compose.yaml).
GALENE_CONTAINER=galene
